{
    "$schema": "https://schema.tauri.app/config/2",
    "identifier": "wallet.nurachain.net",
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "Nura Wallet"
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https:; connect-src ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:*; font-src 'self' data:",
            "capabilities": [
                {
                    "identifier": "main-capability",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:webview:allow-create-webview",
                        "core:webview:allow-webview-close",
                        "core:webview:allow-webview-hide",
                        "core:webview:allow-webview-show",
                        "core:webview:allow-set-webview-position",
                        "core:webview:allow-set-webview-size",
                        "core:webview:allow-get-all-webviews",

                        "store:allow-delete",
                        "store:allow-load",
                        "store:allow-save",
                        "store:allow-get",
                        "store:allow-set",

                        "os:allow-hostname",
                        "os:allow-platform",
                        "os:allow-os-type",
                        "os:allow-version",
                        "os:allow-family",
                        "os:allow-locale",
                        "os:allow-arch",

                        {
                            "identifier": "http:default",
                            "allow": [
                                {
                                    "url": "https://explorer.nurachain.net/*"
                                },
                                {
                                    "url": "https://eth.blockscout.com/*"
                                },
                                {
                                    "url": "https://api.etherscan.io/*"
                                },
                                {
                                    "url": "https://api.coingecko.com/*"
                                },
                                {
                                    "url": "https://api.covalenthq.com/*"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "android": {
            "minSdkVersion": 24
        }
    }
}
