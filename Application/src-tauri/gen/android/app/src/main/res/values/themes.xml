<resources>

    <style name="Theme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- Painted before the WebView has anything on screen; without it the launch frame is white. -->
        <item name="android:windowBackground">@color/WindowBackground</item>

        <!-- The web content draws edge to edge, so the bars must not paint a background of their own. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

    </style>

</resources>
