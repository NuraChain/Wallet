{
    "$schema": "https://schema.tauri.app/config/2",
    "identifier": "io.nurawallet.linux",
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "Nura Wallet",
                "decorations": true,
                "resizable": true,
                "center": true,
                "height": 640,
                "width": 360
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                {
                    "identifier": "main-capability",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:webview:allow-create-webview",
                        "core:webview:allow-webview-close",
                        "core:webview:allow-set-webview-position",
                        "core:webview:allow-set-webview-size",
                        "core:webview:allow-get-all-webviews",

                        "store:allow-delete",
                        "store:allow-load",
                        "store:allow-save",
                        "store:allow-get",
                        "store:allow-set",

                        "os:allow-hostname",
                        "os:allow-platform",
                        "os:allow-os-type",
                        "os:allow-version",
                        "os:allow-family",
                        "os:allow-locale",
                        "os:allow-arch",

                        "fs:allow-mkdir",
                        "fs:allow-write-file",
                        "fs:allow-write-text-file",
                        "fs:allow-picture-write-recursive",
                        "fs:allow-download-write-recursive"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb"
        ],
        "icon": [
            "icons/icon.png"
        ]
    }
}
