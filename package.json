{
    "type": "module",
    "scripts": {
        "dev": "vite",
        "tauri": "tauri",
        "lint": "oxlint",
        "test": "vitest run",
        "format": "oxfmt",
        "lint:fix": "oxlint --fix",
        "build": "tsc && vite build",
        "format:check": "oxfmt --check",
        "desktop": "npm run tauri dev",
        "desktop-build": "npm run tauri build",
        "android": "npm run tauri android dev",
        "android-aab": "npm run tauri android build -- --aab",
        "android-apk": "npm run tauri android build -- --apk",
        "ios": "npm run tauri ios dev",
        "ios-build": "npm run tauri ios build",
        "extension": "npm run extension:types && vite build --app -c vite.config.extension.ts",
        "extension:types": "tsc -p tsconfig.extension.json",
        "extension:lint": "web-ext lint --source-dir .dist-extension/firefox"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/vazirmatn": "^5.2.8",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-deep-link": "^2.6.2",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-http": "^2.8.3",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "@tauri-apps/plugin-os": "^2.4.0",
        "@tauri-apps/plugin-store": "^2.5.0",
        "ethers": "^6.16.0",
        "hash-wasm": "^4.12.0",
        "jsqr": "^1.4.0",
        "lucide-react": "^1.60.0",
        "motion": "^14.4.0",
        "qrcode": "^1.5.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.0",
        "swiper": "^14.3.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.1",
        "@tauri-apps/cli": "^2.12.3",
        "@types/chrome": "^0.3.5",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "rolldown": "^1.2.14",
        "tailwindcss": "^4.3.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "web-ext": "^10.8.0"
    }
